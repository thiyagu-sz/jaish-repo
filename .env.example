# Copy this file to .env and fill in your own keys.
# Never commit the real .env file.

# ---------------------------------------------------------------- defaults --
# Shared fallback used by every agent unless it has its own override below.
# Leave OPENAI_API_KEY blank to run all agents in Demo Mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------ agents --
# Each AI action is handled by its own agent and can use a different model.
# Anything left blank falls back to the defaults above.
#
#   <PREFIX>_MODEL      model name for that agent
#   <PREFIX>_BASE_URL   OpenAI-compatible endpoint (only if it uses another provider)
#   <PREFIX>_API_KEY    key for that provider (only if different from OPENAI_API_KEY)

# Summarization Agent - "Summarize Paper"
SUMMARY_MODEL=
# SUMMARY_BASE_URL=
# SUMMARY_API_KEY=

# Gap Analysis Agent - "Find Research Gaps"
GAP_MODEL=
# GAP_BASE_URL=
# GAP_API_KEY=

# Innovation Agent - "Generate Research Ideas"
IDEA_MODEL=
# IDEA_BASE_URL=
# IDEA_API_KEY=

# ------------------------------------------------------- research sources --
# Optional. OpenAlex works without a key, so this is only needed to raise the
# Semantic Scholar rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex asks for a contact email in the "polite pool" (faster, more reliable).
# CONTACT_EMAIL=

# PORT=3000
