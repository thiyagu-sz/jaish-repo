# Copy this file to .env and fill in your own keys.
# Never commit the real .env file.

# ------------------------------------------------------------- OpenRouter --
# Every language model call in the application goes through OpenRouter.
# Get a key at https://openrouter.ai/keys
#
# Leave OPENROUTER_API_KEY blank to run without a model:
#   - researcher search, paper retrieval and the knowledge graph still work
#   - the paper agents (/api/ai) fall back to clearly-labelled demo text
#   - researcher analysis and gap detection return HTTP 503

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. OpenRouter shows these on its app leaderboard; neither is sensitive.
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=ResearchAI

# ------------------------------------------------------------------ agents --
# Every agent uses OPENROUTER_MODEL unless it is given its own model here.
# OpenRouter addresses models as "<vendor>/<model>", e.g. anthropic/claude-3.5-haiku,
# google/gemini-flash-1.5, meta-llama/llama-3.1-70b-instruct.
#
# There is no per-agent key or base URL: OpenRouter is one gateway in front of
# many providers, so a single key covers all of them.

# Researcher agents (/api/researchers) - no demo fallback, they produce claims
ANALYSIS_MODEL=
GAP_DETECTION_MODEL=

# Paper agents (/api/ai) - these fall back to demo text when unavailable
SUMMARY_MODEL=
GAP_MODEL=
IDEA_MODEL=

# --------------------------------------------------------------- retrieval --
# The RAG layer embeds paper abstracts before retrieving evidence. OpenRouter
# serves embeddings from the same base URL and key, so nothing extra is needed.
#
# With no key it uses a local lexical embedder, so retrieval still runs offline.
# Set EMBEDDINGS_PROVIDER=local to force the local embedder even when a key exists.
# EMBEDDINGS_PROVIDER=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ------------------------------------------------------- research sources --
# Unchanged. These are the scholarly providers, not the language model.

# Optional. Raises the Semantic Scholar rate limit; without it you will hit 429.
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex asks for a contact email in the "polite pool" (faster, more reliable).
# Recommended: OpenAlex is used to enrich papers with topic and domain metadata.
# CONTACT_EMAIL=

# Optional. OpenAlex is free and needs no key; this is only for premium accounts.
# OPENALEX_API_KEY=

# ------------------------------------------------------------------ tuning --
# PROVIDER_TIMEOUT_MS=12000
# LLM_TIMEOUT_MS=45000
# EMBEDDING_TIMEOUT_MS=20000
# CACHE_TTL_MS=600000
# ANALYSIS_CACHE_TTL_MS=1800000

# PORT=3000
