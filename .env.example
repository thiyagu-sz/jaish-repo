# Copy this file to .env and fill in your own keys.
# Never commit the real .env file.

# LLM provider key used for summaries, research gaps and research ideas.
# Leave blank to run the app in Demo Mode.
OPENAI_API_KEY=

# Optional. OpenAlex works without a key, so this is only needed if you
# switch the research source to Semantic Scholar.
SEMANTIC_SCHOLAR_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAlex asks for a contact email in the "polite pool" (faster, more reliable).
# CONTACT_EMAIL=
# PORT=3000
